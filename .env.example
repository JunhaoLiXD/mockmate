# Copy to .env.local and fill in values. Never commit real secrets.

# Server-only OpenAI key (never expose via NEXT_PUBLIC_*)
OPENAI_API_KEY=

# Fine-grained GitHub token: public repositories, read-only
GITHUB_TOKEN=

# Model IDs are injected via env, never hard-coded
REALTIME_MODEL=
TRANSCRIBE_MODEL=
PLANNER_MODEL=
EVALUATOR_MODEL=

# Optional interviewer voice for the Realtime session (defaults to "marin")
REALTIME_VOICE=

# Kill switches: set to "false" to reject paid API calls / voice sessions
AI_ENABLED=true
VOICE_ENABLED=true
