# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/

# local logs and caches
*.log
.eslintcache

# demo recordings (upload to YouTube/Devpost, never commit)
/recordings/
*.mp4
*.mov
*.webm

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code (personal, per-machine; shared team settings stay in .claude/settings.json)
.claude/settings.local.json
.claude/journal/
.claude/launch.json
.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts
